MONGODB_URI=mongodb://localhost:27017/proctorx
NEXTAUTH_SECRET=your-secret-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Optional Cloudinary free storage
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UNSIGNED_UPLOAD_PRESET=

# Optional remote face-api.js models URL
# NEXT_PUBLIC_FACE_API_MODEL_URL=https://justadudewhohacks.github.io/face-api.js/models

# Python proctoring service (same VM)
# PYTHON_PROCTORING_URL=http://127.0.0.1:8001
# PYTHON_PROCTORING_TIMEOUT_MS=2500

# Optional: Google OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
